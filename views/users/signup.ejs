<% layout("layouts/boilerplate") %>
<body>
<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup For WanderLust</h1>

    <div class="col-6 offset-3">
        <form action="/signup" method="POST" novalidate class="needs-validation mt-3">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" placeholder="Username" class="form-control" required>
                  <div class="invalid-feedback">
                   Username Should Be Required
                  </div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="emial" name="email" placeholder="Email" class="form-control" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" placeholder="Password" class="form-control" required>
            </div>
            <button class="btn add-btn">Signup</button>
        </form>
    </div>
</div>

</body>